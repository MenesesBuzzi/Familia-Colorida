# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API / API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Pode ser a "anon public key" (eyJ...) ou a "publishable key" (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=COLE_A_CHAVE_AQUI
